# 可留空，启动后在网页的“连接设置”中填写。
SUB2API_BASE_URL=
SUB2API_API_KEY=
SUB2API_MODEL=gpt-image-2

# 生图超时，单位秒；支持 5 至 1800 秒。
GENERATION_TIMEOUT_SECONDS=900

# 可选：设置密码后，全站启用浏览器用户名/密码验证。
AUTH_USERNAME=admin
AUTH_PASSWORD=

# Docker Compose 的宿主机端口和绑定地址。
WEB_PORT=3080
BIND_ADDRESS=127.0.0.1

# 直接 npm start 时使用；Compose 内固定为 3000。
PORT=3000
HOST=127.0.0.1
