# 启动前填写 sub2api 地址、API Key 和实际支持的模型；网页不提供连接配置。
SUB2API_BASE_URL=
SUB2API_API_KEY=
SUB2API_MODEL=gpt-image-2

# basic 分组设为 true，由上游决定模型和尺寸，每次生成 1 张。
SUB2API_BASIC_MODE=false

# 生图超时，单位秒；支持 5 至 1800 秒。
GENERATION_TIMEOUT_SECONDS=900

# 首次在网页注册的用户自动成为管理员，无需配置管理员环境变量。

# 默认不信任代理头。仅在应用只经由受控反向代理访问时设为实际代理跳数。
# 一层反向代理设为 1，否则可能错误识别游客 IP，影响每日额度。
TRUST_PROXY=0

# Docker Compose 的宿主机端口和绑定地址。
WEB_PORT=3080
BIND_ADDRESS=127.0.0.1

# 直接 npm start 时使用；Compose 内固定为 3000。
PORT=3000
HOST=127.0.0.1
