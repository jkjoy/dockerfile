# QQ 开放平台应用凭据，不是 QQ 账号密码。
QQ_APP_ID=
QQ_APP_SECRET=

# 必填；生成随机值：openssl rand -hex 32
BOT_API_TOKEN=

# 只需通知时，下面全部留空；管理指令需要同时配置插件的独立开关。
# 例如 https://blog.example.com/action/enhancement-edit?do=qq-agent-command
# 未启用伪静态时保留 /index.php/action/，子目录安装也需保留完整路径。
ENHANCEMENT_COMMAND_URL=
# 再生成另一个密钥，必须与 BOT_API_TOKEN 不同。
ENHANCEMENT_COMMAND_SECRET=
# 发送“我的ID”取得用户 OpenID；用逗号分隔多个值，最多 20 个。
QQ_ALLOWED_USERS=
# 允许管理操作的群 OpenID；留空则禁止群管理，只允许白名单用户私聊管理。
QQ_ALLOWED_GROUPS=

# compose.yaml 固定容器监听与持久目录。
BOT_HOST=0.0.0.0
BOT_PORT=8080
BOT_DATA_DIR=/data
